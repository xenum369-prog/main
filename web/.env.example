# PostgreSQL is used in development and production; set a unique, URL-encoded password.
DATABASE_URL="postgresql://maintenance:change-me@localhost:5432/maintenance?schema=public"
POSTGRES_PASSWORD="replace-with-a-unique-random-password"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
# Required by the one-time admin bootstrap command; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ORGANIZATION="Maintenance Organization"
BOOTSTRAP_LOCATION="Main Site"
# Required in production. Keep outside the application/public directories.
STORAGE_DIR=""
